# Helix AI IT Helpdesk - Environment Configuration

# Secret key for session management and password reset tokens.
# Generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key

# Database URI (defaults to sqlite:///helpdesk.db if not set)
# Examples:
#   sqlite:///helpdesk.db
#   postgresql://user:password@localhost/helix
HELIX_DATABASE_URI=sqlite:///helpdesk.db

# Ollama server host (defaults to http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434

# Ollama model to use for AI analysis and chat
OLLAMA_CHAT_MODEL=qwen2.5:7b

# Timeout in seconds for Ollama API requests
OLLAMA_TIMEOUT=120

# Email notifications for ticket updates (optional).
# Leave MAIL_SERVER empty to disable email completely.
MAIL_SERVER=
MAIL_PORT=587
# STARTTLS (port 587). Set MAIL_USE_SSL=true instead for port 465.
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Helix IT Helpdesk <no-reply@example.com>
MAIL_TIMEOUT=10
